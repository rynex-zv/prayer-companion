<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="ARM32" />
    <Platform Name="ARM64" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/Backend/">
    <Project Path="PrayAdFree.Tests/PrayAdFree.Tests.csproj" />
    <Project Path="PrayAdFree/PrayAdFree.csproj">
      <Platform Solution="*|ARM32" Project="ARM32" />
      <Platform Solution="*|ARM64" Project="ARM64" />
      <Platform Solution="*|x64" Project="x64" />
      <Platform Solution="*|x86" Project="x86" />
      <Deploy Solution="*|Any CPU" />
      <Deploy Solution="Release|x64" />
    </Project>
  </Folder>
  <Folder Name="/Backend/Providers/" />
  <Folder Name="/Backend/Providers/Win/">
    <Project Path="native-widgets/windows/PrayAdFree.WidgetProvider/PrayAdFree.WidgetProvider.csproj" />
  </Folder>
  <Folder Name="/Core/">
    <Project Path="PrayAdFree.Core/PrayAdFree.Core.csproj" />
  </Folder>
  <Folder Name="/Frontend/">
    <Project Path="Pray.web/Pray.web.csproj" />
  </Folder>
  <Folder Name="/Tools/">
    <File Path=".gitignore" />
    <Project Path="MauiWebber/MauiWebber.csproj" />
    <Project Path="PrayAdFree.WebBridge/PrayAdFree.WebBridge.csproj" />
  </Folder>
</Solution>
