    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Adhan" Version="0.9.0" />
    <EmbeddedResource Include="..\PrayAdFree\Resources\Raw\i18n\*.json" Link="Resources\i18n\%(Filename)%(Extension)" LogicalName="PrayAdFree.Core.Resources.i18n.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\CalendarEvents\*.json" LogicalName="PrayAdFree.Core.Resources.CalendarEvents.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
