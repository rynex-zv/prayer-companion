<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shared_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:padding="12dp">
  <TextView android:id="@+id/widget_shared_text_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" />
  <TextView android:id="@+id/widget_shared_text_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="14sp" />
  <TextView android:id="@+id/widget_shared_text_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#B8FFFFFF" android:textSize="12sp" />
  <TextView android:id="@+id/widget_shared_text_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="#B8FFFFFF" android:textSize="12sp" />
  <Chronometer android:id="@+id/widget_shared_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:countDown="true" android:textColor="#FFFFFFFF" android:textSize="14sp" android:visibility="gone" />
  <ProgressBar android:id="@+id/widget_shared_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="1000" android:visibility="gone" />
  <LinearLayout android:id="@+id/widget_shared_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_shared_row_1_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12sp" /><TextView android:id="@+id/widget_shared_row_1_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" /></LinearLayout>
  <LinearLayout android:id="@+id/widget_shared_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_shared_row_2_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12sp" /><TextView android:id="@+id/widget_shared_row_2_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" /></LinearLayout>
  <LinearLayout android:id="@+id/widget_shared_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_shared_row_3_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12sp" /><TextView android:id="@+id/widget_shared_row_3_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" /></LinearLayout>
  <LinearLayout android:id="@+id/widget_shared_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_shared_row_4_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12sp" /><TextView android:id="@+id/widget_shared_row_4_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" /></LinearLayout>
  <LinearLayout android:id="@+id/widget_shared_row_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_shared_row_5_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12sp" /><TextView android:id="@+id/widget_shared_row_5_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" /></LinearLayout>
  <LinearLayout android:id="@+id/widget_shared_row_6" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/widget_shared_row_6_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:textSize="12sp" /><TextView android:id="@+id/widget_shared_row_6_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="12sp" /></LinearLayout>
  <LinearLayout android:id="@+id/widget_shared_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:visibility="gone"><Button android:id="@+id/widget_shared_action_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="36dp" android:maxLines="1" android:textSize="11sp" /><Button android:id="@+id/widget_shared_action_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="36dp" android:maxLines="1" android:textSize="11sp" /></LinearLayout>
</LinearLayout>
