<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">
  <TextView
      android:id="@+id/prayer_widget_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#D4E1E8"
      android:textSize="11sp"
      android:textStyle="bold" />
  <TextView
      android:id="@+id/prayer_widget_next"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="3dp"
      android:textColor="#7DE5CC"
      android:textSize="10sp" />
  <TextView
      android:id="@+id/prayer_widget_tiny_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textColor="#F5F7FA"
      android:textSize="16sp"
      android:textStyle="bold" />
  <TextView
      android:id="@+id/prayer_widget_tiny_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:textColor="#F5F7FA"
      android:textSize="13sp" />
</LinearLayout>
