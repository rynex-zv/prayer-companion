<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:padding="14dp">
  <TextView
      android:id="@+id/tasbih_widget_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#D4E1E8"
      android:textSize="12sp"
      android:textStyle="bold" />
  <LinearLayout
      android:id="@+id/tasbih_widget_preset_switcher"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">
    <Button
        android:id="@+id/tasbih_widget_preset_previous"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_button_background"
        android:textColor="#F5F7FA"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/tasbih_widget_preset"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="#7DE5CC"
        android:textSize="11sp" />
    <Button
        android:id="@+id/tasbih_widget_preset_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_button_background"
        android:textColor="#F5F7FA"
        android:textSize="14sp" />
  </LinearLayout>
  <TextView
      android:id="@+id/tasbih_widget_phrase"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textColor="#F5F7FA"
      android:textSize="16sp"
      android:textStyle="bold" />
  <TextView
      android:id="@+id/tasbih_widget_progress"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:textColor="#8FA8B5"
      android:textSize="11sp" />
  <TextView
      android:id="@+id/tasbih_widget_total"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:textColor="#8FA8B5"
      android:textSize="11sp" />
  <TextView
      android:id="@+id/tasbih_widget_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:textColor="#F5F7FA"
      android:textSize="28sp"
      android:textStyle="bold" />
  <Button
      android:id="@+id/tasbih_widget_increment"
      android:layout_width="match_parent"
      android:layout_height="92dp"
      android:layout_marginTop="12dp"
      android:background="@drawable/widget_button_background"
      android:textColor="#F5F7FA"
      android:textSize="30sp"
      android:textStyle="bold" />
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal">
    <Button
        android:id="@+id/tasbih_widget_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_button_background"
        android:textColor="#F5F7FA"
        android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
