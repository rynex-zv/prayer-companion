<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:padding="14dp">
  <TextView
      android:id="@+id/prayer_widget_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#D4E1E8"
      android:textSize="12sp"
      android:textStyle="bold" />
  <TextView
      android:id="@+id/prayer_widget_next"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:textColor="#7DE5CC"
      android:textSize="11sp" />
  <TextView
      android:id="@+id/prayer_widget_next_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textColor="#F5F7FA"
      android:textSize="18sp"
      android:textStyle="bold" />
  <TextView
      android:id="@+id/prayer_widget_next_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#F5F7FA"
      android:textSize="14sp" />
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal">
    <TextView
        android:id="@+id/prayer_widget_follow_1_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#D4E1E8"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/prayer_widget_follow_1_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D4E1E8"
        android:textSize="12sp" />
  </LinearLayout>
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:orientation="horizontal">
    <TextView
        android:id="@+id/prayer_widget_follow_2_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#D4E1E8"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/prayer_widget_follow_2_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D4E1E8"
        android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
