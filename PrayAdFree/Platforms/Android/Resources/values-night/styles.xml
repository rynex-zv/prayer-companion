        <item name="android:windowBackground">@drawable/pray_dialog_bg</item>
        <item name="android:textColorPrimary">#EAF1FA</item>
        <item name="android:textColorSecondary">#95A7BC</item>
        <item name="android:colorAccent">#2FB79D</item>
