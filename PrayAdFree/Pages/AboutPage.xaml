<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
             x:Class="Pray_Ad_Free.Pages.AboutPage"
             Title="{loc:Loc About}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyTop}, Dark={StaticResource DarkSkyTop}}" Offset="0"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyMid}, Dark={StaticResource DarkSkyMid}}" Offset="0.6"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="14" Padding="24,24,24,32">
                <Label Text="{loc:Loc About}" FontSize="34" HorizontalTextAlignment="Center" FontAttributes="Bold" />

                <Border Padding="24" StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border WidthRequest="94"
                                HeightRequest="94"
                                StrokeThickness="0"
                                StrokeShape="Ellipse"
                                BackgroundColor="#D1AD3A"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Label Text="☆" FontSize="42" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Label Text="{Binding AppName}" FontSize="30" HorizontalTextAlignment="Center" FontAttributes="Bold" />
                        <Label Text="{Binding Tagline}" FontSize="14" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark=#8CA0B6}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="♡" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark=#EAB308}" />
                            <Label Grid.Column="1" Text="{Binding Privacy}" FontSize="13" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="◍" FontSize="24" TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark=#EAB308}" />
                            <Label Grid.Column="1" Text="{Binding Source}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Contact}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark=#8CA0B6}" />
                        <Button Text="{loc:Loc ReportIssue}" Clicked="OnReportClicked" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
