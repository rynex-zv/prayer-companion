<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pray_Ad_Free.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
    Title="{loc:Loc About}">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0"   Color="{AppThemeBinding Light={StaticResource SkyTop},  Dark={StaticResource DarkSkyTop}}" />
                <GradientStop Offset="0.5" Color="{AppThemeBinding Light={StaticResource SkyMid},  Dark={StaticResource DarkSkyMid}}" />
                <GradientStop Offset="1"   Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,36" Spacing="14">

                <Label
                    Text="{loc:Loc About}"
                    FontSize="30"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <!-- App identity -->
                <Border
                    Padding="24,20"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceHighlightDark}}">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border
                            WidthRequest="80" HeightRequest="80"
                            StrokeThickness="0"
                            StrokeShape="Ellipse"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                            HorizontalOptions="Center">
                            <Image
                                Source="icon.png"
                                WidthRequest="64"
                                HeightRequest="64"
                                Aspect="AspectFit"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding AppName}" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Tagline}" FontSize="13" HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Info -->
                <Border
                    Padding="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceHighlightDark}}">
                    <VerticalStackLayout>
                        <Grid Padding="18,16" ColumnDefinitions="32,*" ColumnSpacing="14">
                            <Label Text="♡" FontSize="20" TextColor="{StaticResource Accent}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding Privacy}" FontSize="13" />
                        </Grid>
                        <BoxView HeightRequest="1" Margin="18,0" />
                        <Grid Padding="18,16" ColumnDefinitions="32,*" ColumnSpacing="14">
                            <Label Text="◍" FontSize="20" TextColor="{StaticResource Teal}" VerticalOptions="Start" />
                            <Label Grid.Column="1" Text="{Binding Source}" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Contact -->
                <Border
                    Padding="18,16"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceHighlightDark}}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            Text="{Binding Maintainer}"
                            FontSize="14"
                            FontAttributes="Bold" />
                        <Label
                            Text="{Binding Contact}"
                            FontSize="13"
                            TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                                <Label Text="Email" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Email}" FontSize="13" LineBreakMode="CharacterWrap" />
                            </Grid>
                            <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                                <Label Text="Phone" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Phone}" FontSize="13" />
                            </Grid>
                            <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                                <Label Text="Website" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Website}" FontSize="13" LineBreakMode="CharacterWrap" />
                            </Grid>
                        </VerticalStackLayout>
                        <Label
                            Text="{Binding WebsiteNote}"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                        <Button
                            Text="Email Rynex"
                            Clicked="OnEmailClicked"
                            CornerRadius="14"
                            HeightRequest="46" />
                        <Button
                            Text="Call +31 6 10331734"
                            Clicked="OnPhoneClicked"
                            CornerRadius="14"
                            HeightRequest="46" />
                        <Button
                            Text="Open website"
                            Clicked="OnWebsiteClicked"
                            CornerRadius="14"
                            HeightRequest="46" />
                        <Button
                            Text="{loc:Loc ReportIssue}"
                            Clicked="OnReportClicked"
                            CornerRadius="14"
                            HeightRequest="46" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

