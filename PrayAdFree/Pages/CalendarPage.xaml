<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
             x:Class="Pray_Ad_Free.Pages.CalendarPage"
             Title="{loc:Loc Calendar}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyTop}, Dark={StaticResource DarkSkyTop}}" Offset="0"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyMid}, Dark={StaticResource DarkSkyMid}}" Offset="0.6"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid RowDefinitions="Auto,*" Padding="24,18,24,16" RowSpacing="14">
            <VerticalStackLayout Grid.Row="0" Spacing="12">
                <Label Text="{loc:Loc Calendar}" FontSize="36" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Border Padding="14" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Loc Load}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="End" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Button Text="‹" WidthRequest="44" HeightRequest="44" Command="{Binding LoadCommand}" />
                            <DatePicker Grid.Column="1" Date="{Binding SelectedMonth}" HorizontalOptions="Fill" />
                            <Button Grid.Column="2" Text="›" WidthRequest="44" HeightRequest="44" Command="{Binding LoadCommand}" />
                        </Grid>
                        <Label Text="{Binding StatusMessage}" FontSize="12" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Days}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureAllItems"
                            VerticalOptions="FillAndExpand">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14" StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSandMid}}" StrokeThickness="0" Padding="10,6" StrokeShape="RoundRectangle 18">
                                        <Label Text="{Binding Hijri}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource Accent}}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Date}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="End" LineBreakMode="NoWrap" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                                    <Border Padding="8" MinimumHeightRequest="86" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource DarkSandMid}}" StrokeThickness="0" Grid.Row="0" Grid.Column="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Fajr}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding Fajr}" FontSize="16" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Padding="8" MinimumHeightRequest="86" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource DarkSandMid}}" StrokeThickness="0" Grid.Row="0" Grid.Column="1">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Sunrise}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding Sunrise}" FontSize="16" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Padding="8" MinimumHeightRequest="86" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource DarkSandMid}}" StrokeThickness="0" Grid.Row="0" Grid.Column="2">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Dhuhr}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding Dhuhr}" FontSize="16" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Padding="8" MinimumHeightRequest="86" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource DarkSandMid}}" StrokeThickness="0" Grid.Row="1" Grid.Column="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Asr}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding Asr}" FontSize="16" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Padding="8" MinimumHeightRequest="86" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource DarkSandMid}}" StrokeThickness="0" Grid.Row="1" Grid.Column="1">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Maghrib}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding Maghrib}" FontSize="16" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Padding="8" MinimumHeightRequest="86" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource DarkSandMid}}" StrokeThickness="0" Grid.Row="1" Grid.Column="2">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Isha}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding Isha}" FontSize="16" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
