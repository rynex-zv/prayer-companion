<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pray_Ad_Free.Pages.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
    Title="{loc:Loc Calendar}">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0"   Color="{AppThemeBinding Light={StaticResource SkyTop},  Dark={StaticResource DarkSkyTop}}" />
                <GradientStop Offset="0.5" Color="{AppThemeBinding Light={StaticResource SkyMid},  Dark={StaticResource DarkSkyMid}}" />
                <GradientStop Offset="1"   Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid RowDefinitions="Auto,*" Padding="20,20,20,16" RowSpacing="14">

            <!-- Header controls -->
            <VerticalStackLayout Grid.Row="0" Spacing="10">
                <Label
                    Text="{loc:Loc Calendar}"
                    FontSize="30"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <Border
                    Padding="16,14"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceHighlightDark}}">
                    <VerticalStackLayout Spacing="10">
                        <!-- Month nav -->
                        <Grid ColumnDefinitions="44,*,44" ColumnSpacing="10">
                            <Button
                                Text="‹"
                                WidthRequest="44" HeightRequest="44"
                                CornerRadius="14"
                                Command="{Binding PreviousMonthCommand}" />
                            <DatePicker
                                Grid.Column="1"
                                Date="{Binding SelectedMonth}"
                                Format="MMMM yyyy"
                                HorizontalOptions="Fill" />
                            <Button
                                Grid.Column="2"
                                Text="›"
                                WidthRequest="44" HeightRequest="44"
                                CornerRadius="14"
                                Command="{Binding NextMonthCommand}" />
                        </Grid>
                        <!-- Action buttons -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="{loc:Loc Today}" Command="{Binding TodayCommand}" CornerRadius="14" HeightRequest="42" />
                            <Button Grid.Column="1" Text="{loc:Loc Load}" Command="{Binding LoadCommand}" CornerRadius="14" HeightRequest="42" />
                        </Grid>
                        <Label
                            Text="{Binding StatusMessage}"
                            FontSize="11"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Days list -->
            <CollectionView
                Grid.Row="1"
                ItemsSource="{Binding Days}"
                SelectionMode="None"
                ItemSizingStrategy="MeasureAllItems"
                VerticalOptions="FillAndExpand">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16,14"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceHighlightDark}}">
                            <VerticalStackLayout Spacing="12">

                                <!-- Date header -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                                        Stroke="{AppThemeBinding Light={StaticResource AccentMid}, Dark={StaticResource AccentMidDark}}"
                                        StrokeThickness="1"
                                        Padding="10,5"
                                        StrokeShape="RoundRectangle 12">
                                        <Label
                                            Text="{Binding Hijri}"
                                            FontSize="11"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource Accent}}" />
                                    </Border>
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Date}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="End"
                                        LineBreakMode="NoWrap" />
                                </Grid>

                                <!-- Prayer grid 3×2 -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <Border Padding="8" MinimumHeightRequest="68"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12" Grid.Row="0" Grid.Column="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Fajr}" FontSize="11" HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                            <Label Text="{Binding Fajr}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Padding="8" MinimumHeightRequest="68"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12" Grid.Row="0" Grid.Column="1">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Sunrise}" FontSize="11" HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                            <Label Text="{Binding Sunrise}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Padding="8" MinimumHeightRequest="68"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12" Grid.Row="0" Grid.Column="2">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Dhuhr}" FontSize="11" HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                            <Label Text="{Binding Dhuhr}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Padding="8" MinimumHeightRequest="68"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12" Grid.Row="1" Grid.Column="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Asr}" FontSize="11" HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                            <Label Text="{Binding Asr}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Padding="8" MinimumHeightRequest="68"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12" Grid.Row="1" Grid.Column="1">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Maghrib}" FontSize="11" HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                            <Label Text="{Binding Maghrib}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Padding="8" MinimumHeightRequest="68"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12" Grid.Row="1" Grid.Column="2">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{loc:Loc Prayer_Isha}" FontSize="11" HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                            <Label Text="{Binding Isha}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Grid>
</ContentPage>

