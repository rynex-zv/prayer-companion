<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pray_Ad_Free.Pages.CalendarPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
    Title="{loc:Loc Calendar}">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource SkyTop}, Dark={StaticResource DarkSkyTop}}" />
                <GradientStop Offset="0.5" Color="{AppThemeBinding Light={StaticResource SkyMid}, Dark={StaticResource DarkSkyMid}}" />
                <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid
            Padding="20,20,20,16"
            RowDefinitions="Auto,*"
            RowSpacing="14">

            <!--  Header controls  -->
            <VerticalStackLayout Grid.Row="0" Spacing="10">
                <Label
                    FontAttributes="Bold"
                    FontSize="30"
                    HorizontalTextAlignment="Center"
                    Text="{loc:Loc Calendar}" />

                <Border
                    Padding="16,14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass},
                                                      Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                             Dark={StaticResource SurfaceHighlightDark}}"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <!--  Month nav  -->
                        <Grid ColumnDefinitions="44,*,44" ColumnSpacing="10">
                            <Button
                                Command="{Binding PreviousMonthCommand}"
                                CornerRadius="14"
                                HeightRequest="44"
                                Text="&lt;"
                                WidthRequest="44" />
                            <DatePicker
                                Grid.Column="1"
                                Date="{Binding SelectedMonth}"
                                Format="MMMM yyyy"
                                HorizontalOptions="Fill" />
                            <Button
                                Grid.Column="2"
                                Command="{Binding NextMonthCommand}"
                                CornerRadius="14"
                                HeightRequest="44"
                                Text="&gt;"
                                WidthRequest="44" />
                        </Grid>
                        <!--  Action buttons  -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button
                                Command="{Binding TodayCommand}"
                                CornerRadius="14"
                                HeightRequest="42"
                                Text="{loc:Loc Today}" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding LoadCommand}"
                                CornerRadius="14"
                                HeightRequest="42"
                                Text="{loc:Loc Load}" />
                        </Grid>
                        <Label
                            FontSize="11"
                            HorizontalTextAlignment="Center"
                            Text="{Binding StatusMessage}"
                            TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                        Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!--  Days list  -->
            <CollectionView
                Grid.Row="1"
                ItemSizingStrategy="MeasureAllItems"
                ItemsSource="{Binding Days}"
                SelectionMode="None"
                VerticalOptions="FillAndExpand">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16,14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass},
                                                              Dark={StaticResource SurfaceGlassDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                                     Dark={StaticResource SurfaceHighlightDark}}"
                            StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="12">

                                <!--  Date header  -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border
                                        Padding="10,5"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft},
                                                                          Dark={StaticResource AccentSoftDark}}"
                                        Stroke="{AppThemeBinding Light={StaticResource AccentMid},
                                                                 Dark={StaticResource AccentMidDark}}"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="1">
                                        <Label
                                            FontSize="11"
                                            Text="{Binding Hijri}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDark},
                                                                        Dark={StaticResource Accent}}" />
                                    </Border>
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        HorizontalTextAlignment="End"
                                        LineBreakMode="NoWrap"
                                        Text="{Binding Date}" />
                                </Grid>

                                <!--  Prayer grid 3�2  -->
                                <Grid
                                    ColumnDefinitions="*,*,*"
                                    ColumnSpacing="6"
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="6">
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Padding="8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight},
                                                                          Dark={StaticResource SurfaceHighlightDark}}"
                                        MinimumHeightRequest="68"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontSize="11"
                                                HorizontalTextAlignment="Center"
                                                Text="{loc:Loc Prayer_Fajr}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                            Dark={StaticResource TextMutedDark}}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Fajr}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Padding="8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight},
                                                                          Dark={StaticResource SurfaceHighlightDark}}"
                                        MinimumHeightRequest="68"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontSize="11"
                                                HorizontalTextAlignment="Center"
                                                Text="{loc:Loc Prayer_Sunrise}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                            Dark={StaticResource TextMutedDark}}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Sunrise}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Padding="8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight},
                                                                          Dark={StaticResource SurfaceHighlightDark}}"
                                        MinimumHeightRequest="68"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontSize="11"
                                                HorizontalTextAlignment="Center"
                                                Text="{loc:Loc Prayer_Dhuhr}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                            Dark={StaticResource TextMutedDark}}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Dhuhr}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Padding="8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight},
                                                                          Dark={StaticResource SurfaceHighlightDark}}"
                                        MinimumHeightRequest="68"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontSize="11"
                                                HorizontalTextAlignment="Center"
                                                Text="{loc:Loc Prayer_Asr}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                            Dark={StaticResource TextMutedDark}}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Asr}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Padding="8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight},
                                                                          Dark={StaticResource SurfaceHighlightDark}}"
                                        MinimumHeightRequest="68"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontSize="11"
                                                HorizontalTextAlignment="Center"
                                                Text="{loc:Loc Prayer_Maghrib}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                            Dark={StaticResource TextMutedDark}}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Maghrib}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Padding="8"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight},
                                                                          Dark={StaticResource SurfaceHighlightDark}}"
                                        MinimumHeightRequest="68"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontSize="11"
                                                HorizontalTextAlignment="Center"
                                                Text="{loc:Loc Prayer_Isha}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                            Dark={StaticResource TextMutedDark}}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HorizontalTextAlignment="Center"
                                                Text="{Binding Isha}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>
    </Grid>
</ContentPage>

