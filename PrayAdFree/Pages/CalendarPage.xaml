<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
             x:Class="Pray_Ad_Free.Pages.CalendarPage"
             Title="{loc:Loc Calendar}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource SandTop}, Dark={StaticResource DarkSandTop}}" Offset="0"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SandMid}, Dark={StaticResource DarkSandMid}}" Offset="0.6"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SandBase}, Dark={StaticResource DarkSandBase}}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <VerticalStackLayout Spacing="16" Padding="20,24">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="12">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <DatePicker Date="{Binding SelectedMonth}" />
                    <Button Text="{loc:Loc Load}" Command="{Binding LoadCommand}" />
                    <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="{StaticResource TextSubtle}" />
                </HorizontalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Days}" SelectionMode="None" ItemsLayout="VerticalList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSolid}, Dark={StaticResource SurfaceGlassDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Padding="14"
                                Margin="0,0,0,12">
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Date}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                    <Label Text="{Binding Hijri}" FontSize="12" TextColor="{StaticResource TextSubtle}" />
                                </VerticalStackLayout>

                                <Grid Grid.Column="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{loc:Loc Prayer_Fajr}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                        <Label Text="{Binding Fajr}" FontSize="14" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="2" Grid.Column="1">
                                        <Label Text="{loc:Loc Prayer_Dhuhr}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                        <Label Text="{Binding Dhuhr}" FontSize="14" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="2" Grid.Row="1">
                                        <Label Text="{loc:Loc Prayer_Asr}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                        <Label Text="{Binding Asr}" FontSize="14" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="2" Grid.Row="1" Grid.Column="1">
                                        <Label Text="{loc:Loc Prayer_Maghrib}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                        <Label Text="{Binding Maghrib}" FontSize="14" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="2" Grid.Row="2">
                                        <Label Text="{loc:Loc Prayer_Isha}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                        <Label Text="{Binding Isha}" FontSize="14" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
