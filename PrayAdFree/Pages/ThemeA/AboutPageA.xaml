<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
             x:Class="Pray_Ad_Free.Pages.ThemeA.AboutPageA"
             Title="{loc:Loc About}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource NightTop}" Offset="0"/>
                <GradientStop Color="{StaticResource NightBase}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <VerticalStackLayout Spacing="14" Padding="24,32">
            <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                <Border
                    WidthRequest="68"
                    HeightRequest="68"
                    StrokeThickness="0"
                    StrokeShape="Ellipse"
                    BackgroundColor="{StaticResource AccentSoft}"
                    VerticalOptions="Center">
                    <Image
                        Source="icon.png"
                        WidthRequest="54"
                        HeightRequest="54"
                        Aspect="AspectFit"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="{Binding AppName}"
                           FontSize="26"
                           TextColor="{StaticResource Accent}" />
                    <Label Text="{Binding Tagline}" FontSize="16" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Source}" FontSize="14" />
                    <Label Text="{Binding Privacy}" FontSize="14" />
                    <Label Text="{Binding Maintainer}" FontSize="14" FontAttributes="Bold" />
                    <Label Text="{Binding Contact}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                        <Label Text="Email" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding Email}" FontSize="12" LineBreakMode="CharacterWrap" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                        <Label Text="Phone" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding Phone}" FontSize="12" />
                    </Grid>
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                        <Label Text="Website" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding Website}" FontSize="12" LineBreakMode="CharacterWrap" />
                    </Grid>
                    <Label Text="{Binding WebsiteNote}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                    <Button Text="Email Rynex" Clicked="OnEmailClicked" />
                    <Button Text="Call +31 6 10331734" Clicked="OnPhoneClicked" />
                    <Button Text="Open website" Clicked="OnWebsiteClicked" />
                    <Button Text="{loc:Loc ReportIssue}" Clicked="OnReportClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
