<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
             x:Class="Pray_Ad_Free.Pages.ThemeA.HomePageA"
             Title="{loc:Loc Today}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyTop}, Dark={StaticResource DarkSkyTop}}" Offset="0"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyMid}, Dark={StaticResource DarkSkyMid}}" Offset="0.5"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <RefreshView IsRefreshing="{Binding IsBusy}"
                     Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="20" Padding="24,32">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Padding="18">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding LocationTitle}"
                                   FontSize="18"
                                  />
                            <Label Text="{Binding GregorianDate}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"/>
                            <Label Text="{Binding HijriDate}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"/>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{loc:Loc NextPrayer}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"/>
                                <Label Text="{Binding NextPrayerName}"
                                       FontSize="12"/>
                                <Label Text="{Binding NextPrayerClock}"
                                       FontSize="12"
                                       TextColor="{StaticResource Accent}" />
                                <Label Text="{Binding NextPrayerBaseClock, StringFormat='({0})'}"
                                       IsVisible="{Binding ShowNextPrayerBaseClock}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   TextColor="{StaticResource TextSubtle}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                Padding="18">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{loc:Loc NextPrayer}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"/>
                                <Label Text="{Binding NextPrayerName}" FontSize="20"/>
                                <Label Text="{Binding NextPrayerClock}"
                                       FontSize="16"
                                       TextColor="{StaticResource Accent}"/>
                                <Label Text="{Binding NextPrayerBaseClock}"
                                       IsVisible="{Binding ShowNextPrayerBaseClock}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                Padding="18"
                                Grid.Column="1">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{loc:Loc TimeLeft}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"/>
                                <Label Text="{Binding Countdown}"
                                      
                                       FontSize="20"/>
                                <Label Text="Stay ready"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSubtle}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSolid}, Dark={StaticResource SurfaceGlassDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="12">
                        <CollectionView ItemsSource="{Binding TodayTimings}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto"
                                          Padding="8,10">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"/>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                            <Label Text="{Binding Time}"
                                                   FontSize="16"
                                                   HorizontalTextAlignment="End"
                                                   TextColor="{StaticResource Accent}"/>
                                            <Label Text="{Binding BaseTime}"
                                                   IsVisible="{Binding ShowBaseTime}"
                                                   FontSize="11"
                                                   HorizontalTextAlignment="End"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            Padding="14">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Padding="10" StrokeThickness="0">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsImsakNext}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsImsakNext}" Value="False">
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{loc:Loc Imsak}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"/>
                                    <Label Text="{Binding ImsakTime}" FontSize="16">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsImsakNext}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsImsakNext}" Value="False">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding NextFastingCountdown}"
                                           FontSize="11"
                                           IsVisible="{Binding IsImsakNext}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Padding="10" StrokeThickness="0" Grid.Column="1">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsIftarNext}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsIftarNext}" Value="False">
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{loc:Loc Iftar}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"/>
                                    <Label Text="{Binding IftarTime}" FontSize="16">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsIftarNext}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsIftarNext}" Value="False">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding NextFastingCountdown}"
                                           FontSize="11"
                                           IsVisible="{Binding IsIftarNext}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
