<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
             x:Class="Pray_Ad_Free.Pages.ThemeA.TasbihPageA"
             Title="{loc:Loc Tasbih}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyTop}, Dark={StaticResource DarkSkyTop}}" Offset="0"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyMid}, Dark={StaticResource DarkSkyMid}}" Offset="0.6"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="18" Padding="24,32">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding CurrentPhrase}" FontSize="20" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding ProgressText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Count}" FontSize="48" HorizontalOptions="Center" />
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Button Text="{loc:Loc AddCount}" Command="{Binding IncrementCommand}" />
                            <Button Text="{loc:Loc Reset}" Command="{Binding ResetCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSolid}, Dark={StaticResource SurfaceGlassDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Loc TasbihPresets}" FontSize="16" />
                        <Picker Title="{loc:Loc TasbihPresets}"
                                ItemsSource="{Binding Presets}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedPreset}"
                                IsEnabled="{Binding IsPresetSelectionEnabled}" />
                        <CollectionView ItemsSource="{Binding PresetItems}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="4,6">
                                        <Label Text="{Binding Text}" FontSize="14" />
                                        <Label Text="{Binding TargetCount}" FontSize="14" Grid.Column="1" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
