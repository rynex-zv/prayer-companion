<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pray_Ad_Free.Pages.TasbihPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
    Title="{loc:Loc Tasbih}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource SkyTop}, Dark={StaticResource DarkSkyTop}}" />
                <GradientStop Offset="0.6" Color="{AppThemeBinding Light={StaticResource SkyMid}, Dark={StaticResource DarkSkyMid}}" />
                <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="24,20,24,26" Spacing="14">
                <Label
                    FontAttributes="Bold"
                    FontSize="34"
                    HorizontalTextAlignment="Center"
                    Text="{loc:Loc Tasbih}" />

                <Border Padding="20" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="14">
                        <Label
                            FontAttributes="Bold"
                            FontSize="34"
                            HorizontalTextAlignment="Center"
                            Text="{Binding CurrentPhrase}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDark},
                                                        Dark={StaticResource Accent}}" />
                        <Border
                            BackgroundColor="Transparent"
                            HeightRequest="180"
                            Stroke="{AppThemeBinding Light={StaticResource SurfaceHighlight},
                                                     Dark=#21314D}"
                            StrokeShape="Ellipse"
                            StrokeThickness="2"
                            WidthRequest="180">
                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="56"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding Count}" />
                                <Label
                                    FontSize="14"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding ProgressText}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                Dark=#8CA0B6}" />
                            </VerticalStackLayout>
                        </Border>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                            <Button
                                Command="{Binding IncrementCommand}"
                                CornerRadius="29"
                                HeightRequest="58"
                                Text="⏵"
                                WidthRequest="74" />
                            <Button
                                Command="{Binding ResetCommand}"
                                CornerRadius="29"
                                HeightRequest="58"
                                Text="↻"
                                WidthRequest="74" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="14" StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            FontSize="12"
                            HorizontalTextAlignment="End"
                            Text="{loc:Loc TasbihPresets}"
                            TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                        Dark=#8CA0B6}" />
                        <Picker
                            Title="{loc:Loc TasbihPresets}"
                            IsEnabled="{Binding IsPresetSelectionEnabled}"
                            ItemDisplayBinding="{Binding Name}"
                            ItemsSource="{Binding Presets}"
                            SelectedItem="{Binding SelectedPreset}" />
                        <CollectionView ItemsSource="{Binding PresetItems}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,2"
                                        Padding="8,10"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight},
                                                                          Dark=#163A3B}"
                                        StrokeThickness="0">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Label
                                                FontSize="14"
                                                Text="{Binding TargetCount, StringFormat='x{0}'}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                            Dark=#8CA0B6}" />
                                            <Label
                                                Grid.Column="1"
                                                FontAttributes="Bold"
                                                FontSize="20"
                                                HorizontalTextAlignment="End"
                                                Text="{Binding Text}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
