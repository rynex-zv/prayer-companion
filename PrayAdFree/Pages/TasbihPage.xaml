<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pray_Ad_Free.Pages.TasbihPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
    Title="{loc:Loc Tasbih}">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource SkyTop}, Dark={StaticResource DarkSkyTop}}" />
                <GradientStop Offset="0.6" Color="{AppThemeBinding Light={StaticResource SkyMid}, Dark={StaticResource DarkSkyMid}}" />
                <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,32" Spacing="14">

                <!--  Counter card  -->
                <Border
                    Padding="24,20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass},
                                                      Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                             Dark={StaticResource SurfaceHighlightDark}}"
                    StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="16">

                        <!--  Phrase  -->
                        <Label
                            FontAttributes="Bold"
                            FontSize="26"
                            HorizontalTextAlignment="Center"
                            Text="{Binding CurrentPhrase}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDark},
                                                        Dark={StaticResource Accent}}" />

                        <!--  Ring counter  -->
                        <Border
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft},
                                                              Dark={StaticResource AccentSoftDark}}"
                            HeightRequest="160"
                            HorizontalOptions="Center"
                            Stroke="{AppThemeBinding Light={StaticResource AccentMid},
                                                     Dark={StaticResource AccentMidDark}}"
                            StrokeShape="Ellipse"
                            StrokeThickness="2"
                            WidthRequest="160">
                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="54"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding Count}" />
                                <Label
                                    FontSize="13"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding ProgressText}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!--  Buttons  -->
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12"
                            HorizontalOptions="Fill">
                            <Button
                                Command="{Binding IncrementCommand}"
                                CornerRadius="22"
                                FontAttributes="Bold"
                                FontSize="15"
                                HeightRequest="52"
                                Text="{loc:Loc TasbihIncrement}" />
                            <Button
                                Grid.Column="1"
                                BackgroundColor="{DynamicResource SubtleActionFillActive}"
                                Command="{Binding ResetCommand}"
                                CornerRadius="22"
                                FontSize="14"
                                HeightRequest="52"
                                Text="{loc:Loc TasbihReset}"
                                TextColor="{DynamicResource SubtleActionForegroundActive}"
                                WidthRequest="90" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!--  Presets card  -->
                <Border
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass},
                                                      Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                             Dark={StaticResource SurfaceHighlightDark}}"
                    StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout>
                        <Grid Padding="18,14,18,10" ColumnDefinitions="*,Auto">
                            <Label
                                CharacterSpacing="0.8"
                                FontSize="11"
                                Text="{loc:Loc TasbihPresets}"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                            Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                            <Picker
                                Title="{loc:Loc TasbihPresets}"
                                Grid.Column="1"
                                FontSize="13"
                                HorizontalOptions="End"
                                IsEnabled="{Binding IsPresetSelectionEnabled}"
                                ItemDisplayBinding="{Binding Name}"
                                ItemsSource="{Binding Presets}"
                                SelectedItem="{Binding SelectedPreset}"
                                WidthRequest="160" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding PresetItems}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="18,11"
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="14">
                                        <Label
                                            FontSize="13"
                                            Text="{Binding TargetCount, StringFormat='x{0}'}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                        Dark={StaticResource TextMutedDark}}"
                                            VerticalOptions="Center"
                                            WidthRequest="36" />
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="20"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding Text}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <BoxView HeightRequest="8" Color="Transparent" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>


