<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
             x:Class="Pray_Ad_Free.Pages.SettingsLocationsPage"
             Title="{loc:Loc Locations}">
    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="24,32">
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Loc Locations}" FontSize="16" />
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="{loc:Loc UseGps}" FontSize="14"/>
                        <Switch IsToggled="{Binding UseGps}" />
                        <Button Text="{loc:Loc UpdateGps}" Command="{Binding RefreshGpsCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="{loc:Loc Country}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                    <Picker Title="{loc:Loc Country}" ItemsSource="{Binding CountryOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedCountry}" IsEnabled="{Binding IsManualLocationEnabled}" />
                    <Label Text="{loc:Loc City}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                    <Picker Title="{loc:Loc City}" ItemsSource="{Binding CityOptions}" ItemDisplayBinding="{Binding Label}" SelectedItem="{Binding SelectedCity}" IsEnabled="{Binding IsManualLocationEnabled}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <Label Text="{loc:Loc Latitude}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                        <Label Text="{loc:Loc Longitude}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" Grid.Column="1" />
                        <Entry Placeholder="{loc:Loc Latitude}" Text="{Binding Latitude}" Grid.Row="1" IsEnabled="{Binding IsManualLocationEnabled}" />
                        <Entry Placeholder="{loc:Loc Longitude}" Text="{Binding Longitude}" Grid.Row="1" Grid.Column="1" IsEnabled="{Binding IsManualLocationEnabled}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
