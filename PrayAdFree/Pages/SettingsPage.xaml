<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
             x:Class="Pray_Ad_Free.Pages.SettingsPage"
             Title="{loc:Loc Settings}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyTop}, Dark={StaticResource DarkSkyTop}}" Offset="0"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyMid}, Dark={StaticResource DarkSkyMid}}" Offset="0.6"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="24,24,24,32">
                <Label Text="{loc:Loc Settings}" FontSize="32" HorizontalTextAlignment="Center" FontAttributes="Bold" />

                <Border Padding="0" StrokeShape="RoundRectangle 20" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="18,16" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLocationsClicked" />
                            </Grid.GestureRecognizers>
                            <Label Text="〈" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            <Label Grid.Column="1" Text="{loc:Loc Locations}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            <Label Grid.Column="2" Text="⌖" FontSize="24" TextColor="#2FB79D" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{loc:Loc QiblaPreferences}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}" />
                        <Grid Padding="18,16" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDiagnosticsClicked" />
                            </Grid.GestureRecognizers>
                            <Label Text="〈" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            <Label Grid.Column="1" Text="{loc:Loc ThemeMode}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            <Label Grid.Column="2" Text="⌁" FontSize="24" TextColor="#4EC1FF" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{loc:Loc ThemeVariant}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}" />
                        <Grid Padding="18,16" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAdhanClicked" />
                            </Grid.GestureRecognizers>
                            <Label Text="〈" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            <Label Grid.Column="1" Text="{loc:Loc AdhanCustomizations}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            <Label Grid.Column="2" Text="◔" FontSize="24" TextColor="#EAB308" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{loc:Loc AdhanSound}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}" />
                        <Grid Padding="18,16" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotificationsClicked" />
                            </Grid.GestureRecognizers>
                            <Label Text="〈" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            <Label Grid.Column="1" Text="{loc:Loc Notifications}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            <Label Grid.Column="2" Text="◌" FontSize="24" TextColor="#C66BFF" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{loc:Loc AdhanReminders}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}" />
                        <Grid Padding="18,16" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTasbihClicked" />
                            </Grid.GestureRecognizers>
                            <Label Text="〈" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            <Label Grid.Column="1" Text="{loc:Loc Tasbih}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            <Label Grid.Column="2" Text="◎" FontSize="24" TextColor="#FF4D8D" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{loc:Loc TasbihSettings}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}" />
                        <Grid Padding="18,16" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAboutClicked" />
                            </Grid.GestureRecognizers>
                            <Label Text="〈" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            <Label Grid.Column="1" Text="{loc:Loc About}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            <Label Grid.Column="2" Text="ⓘ" FontSize="24" TextColor="#2FB79D" />
                            <Label Grid.Column="1" Grid.Row="1" Text="{loc:Loc About}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

