<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pray_Ad_Free.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
    Title="{loc:Loc Settings}">
    <ContentPage.Resources>
        <Style x:Key="SettingsIconFrame" TargetType="Border">
            <Setter Property="WidthRequest" Value="32" />
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 9" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="SettingsIconCanvas" TargetType="Grid">
            <Setter Property="WidthRequest" Value="18" />
            <Setter Property="HeightRequest" Value="18" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0"   Color="{AppThemeBinding Light={StaticResource SkyTop},  Dark={StaticResource DarkSkyTop}}" />
                <GradientStop Offset="0.6" Color="{AppThemeBinding Light={StaticResource SkyMid},  Dark={StaticResource DarkSkyMid}}" />
                <GradientStop Offset="1"   Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,36" Spacing="10">

                <Label
                    Text="{loc:Loc Settings}"
                    FontSize="30"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    Margin="0,0,0,6" />

                <!-- Group 1: Location & Theme -->
                <Border
                    Padding="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceHighlightDark}}">
                    <VerticalStackLayout>

                        <!-- Locations -->
                        <Grid Padding="16,14" ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnLocationsClicked" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource SettingsIconFrame}" BackgroundColor="{StaticResource TealSoft}">
                                <Grid Style="{StaticResource SettingsIconCanvas}">
                                    <Border WidthRequest="8" HeightRequest="8" Stroke="{StaticResource Teal}" StrokeThickness="1.6"
                                        BackgroundColor="Transparent" StrokeShape="RoundRectangle 99" />
                                    <BoxView WidthRequest="2" HeightRequest="18" Color="{StaticResource Teal}"
                                        HorizontalOptions="Center" VerticalOptions="Center" />
                                    <BoxView WidthRequest="18" HeightRequest="2" Color="{StaticResource Teal}"
                                        HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Loc Locations}" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{loc:Loc QiblaPreferences}" FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Margin="18,0" />

                        <!-- Theme -->
                        <Grid Padding="16,14" ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnDiagnosticsClicked" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource SettingsIconFrame}" BackgroundColor="#1A3A5C">
                                <Grid Style="{StaticResource SettingsIconCanvas}">
                                    <Border WidthRequest="10" HeightRequest="10" Stroke="#4EC1FF" StrokeThickness="1.6"
                                        BackgroundColor="Transparent" StrokeShape="RoundRectangle 99" />
                                    <BoxView WidthRequest="2" HeightRequest="14" Color="#4EC1FF"
                                        HorizontalOptions="Center" VerticalOptions="Center" Rotation="45" />
                                    <BoxView WidthRequest="14" HeightRequest="2" Color="#4EC1FF"
                                        HorizontalOptions="Center" VerticalOptions="Center" Rotation="45" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Loc ThemeMode}" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{loc:Loc ThemeVariant}" FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Group 2: Adhan, Notifications, Permissions, Alarms -->
                <Border
                    Padding="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceHighlightDark}}">
                    <VerticalStackLayout>

                        <!-- Adhan -->
                        <Grid Padding="16,14" ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnAdhanClicked" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource SettingsIconFrame}" BackgroundColor="{StaticResource AccentSoft}">
                                <Grid Style="{StaticResource SettingsIconCanvas}">
                                    <Path Data="M9,3 C6.6,3 4.8,4.9 4.8,7.2 V10.6 L3.3,12.5 V13.7 H14.7 V12.5 L13.2,10.6 V7.2 C13.2,4.9 11.4,3 9,3"
                                        Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                                        StrokeLineCap="Round" StrokeLineJoin="Round"
                                        WidthRequest="18" HeightRequest="18"
                                        HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Border WidthRequest="3" HeightRequest="3" BackgroundColor="{StaticResource Accent}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 99"
                                        HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,1" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Loc AdhanCustomizations}" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{loc:Loc AdhanSound}" FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Margin="18,0" />

                        <!-- Notifications -->
                        <Grid Padding="16,14" ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnNotificationsClicked" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource SettingsIconFrame}" BackgroundColor="#2A1A3C">
                                <Grid Style="{StaticResource SettingsIconCanvas}">
                                    <Path Data="M9,4 C6.8,4 5.2,5.7 5.2,7.8 V10.2 L3.8,11.9 V13 H14.2 V11.9 L12.8,10.2 V7.8 C12.8,5.7 11.2,4 9,4"
                                        Stroke="#C66BFF" StrokeThickness="1.6"
                                        StrokeLineCap="Round" StrokeLineJoin="Round"
                                        WidthRequest="18" HeightRequest="18"
                                        HorizontalOptions="Center" VerticalOptions="Center" />
                                    <BoxView WidthRequest="7" HeightRequest="2" Color="#C66BFF"
                                        HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,2" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Loc Notifications}" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{loc:Loc AdhanReminders}" FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Margin="18,0" />

                        <!-- Permissions -->
                        <Grid Padding="16,14" ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnPermissionsClicked" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource SettingsIconFrame}" BackgroundColor="#1A3A5C">
                                <Grid Style="{StaticResource SettingsIconCanvas}">
                                    <Path Data="M9,2.4 L14.6,4.5 V8.8 C14.6,11.5 13.2,13.8 9,15.8 C4.8,13.8 3.4,11.5 3.4,8.8 V4.5 Z"
                                        Stroke="#4EC1FF" StrokeThickness="1.6"
                                        StrokeLineCap="Round" StrokeLineJoin="Round"
                                        WidthRequest="18" HeightRequest="18"
                                        HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Border WidthRequest="4" HeightRequest="4" BackgroundColor="#4EC1FF"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 99"
                                        HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Loc PermissionsTitle}" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{loc:Loc PermissionsSubtitle}" FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Margin="18,0" />

                        <!-- Alarm Reminders -->
                        <Grid Padding="16,14" ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnAlarmRemindersClicked" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource SettingsIconFrame}" BackgroundColor="{StaticResource TealSoft}">
                                <Grid Style="{StaticResource SettingsIconCanvas}">
                                    <Border WidthRequest="12" HeightRequest="12" Stroke="{StaticResource Teal}" StrokeThickness="1.6"
                                        BackgroundColor="Transparent" StrokeShape="RoundRectangle 99" />
                                    <BoxView WidthRequest="2" HeightRequest="5" Color="{StaticResource Teal}"
                                        HorizontalOptions="Center" VerticalOptions="Start" Margin="0,4,0,0" />
                                    <BoxView WidthRequest="5" HeightRequest="2" Color="{StaticResource Teal}"
                                        HorizontalOptions="Center" VerticalOptions="Center" Margin="2,0,0,0" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Loc AlarmRemindersTitle}" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{loc:Loc AlarmRemindersBuiltIn}" FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Group 3: Tasbih & About -->
                <Border
                    Padding="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceHighlightDark}}">
                    <VerticalStackLayout>

                        <!-- Tasbih -->
                        <Grid Padding="16,14" ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnTasbihClicked" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource SettingsIconFrame}" BackgroundColor="#3A0A1A">
                                <Grid Style="{StaticResource SettingsIconCanvas}" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="2">
                                    <Border WidthRequest="5" HeightRequest="5" BackgroundColor="#FF6B6B"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 99"
                                        VerticalOptions="Center" />
                                    <Border Grid.Column="1" WidthRequest="5" HeightRequest="5" BackgroundColor="#FF6B6B"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 99"
                                        VerticalOptions="Center" Margin="0,4,0,0" />
                                    <Border Grid.Column="2" WidthRequest="5" HeightRequest="5" BackgroundColor="#FF6B6B"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 99"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Loc Tasbih}" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{loc:Loc TasbihSettings}" FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Margin="18,0" />

                        <!-- About -->
                        <Grid Padding="16,14" ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnAboutClicked" /></Grid.GestureRecognizers>
                            <Border Style="{StaticResource SettingsIconFrame}" BackgroundColor="{StaticResource TealSoft}">
                                <Grid Style="{StaticResource SettingsIconCanvas}">
                                    <Border WidthRequest="3" HeightRequest="3" BackgroundColor="{StaticResource Teal}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 99"
                                        HorizontalOptions="Center" VerticalOptions="Start" Margin="0,1,0,0" />
                                    <BoxView WidthRequest="3" HeightRequest="9" Color="{StaticResource Teal}"
                                        HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,1" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{loc:Loc About}" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{loc:Loc About}" FontSize="12"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="20"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
