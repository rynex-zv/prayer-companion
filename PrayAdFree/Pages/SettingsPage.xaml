<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
             x:Class="Pray_Ad_Free.Pages.SettingsPage"
             Title="{loc:Loc Settings}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource SandTop}, Dark={StaticResource DarkSandTop}}" Offset="0"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SandMid}, Dark={StaticResource DarkSandMid}}" Offset="0.6"/>
                <GradientStop Color="{AppThemeBinding Light={StaticResource SandBase}, Dark={StaticResource DarkSandBase}}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="24,32">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{loc:Loc SettingsGroups}" FontSize="16" />
                        <Button Text="{loc:Loc Locations}" Clicked="OnLocationsClicked" />
                        <Button Text="{loc:Loc Diagnostics}" Clicked="OnDiagnosticsClicked" />
                        <Button Text="{loc:Loc AdhanCustomizations}" Clicked="OnAdhanClicked" />
                        <Button Text="{loc:Loc Notifications}" Clicked="OnNotificationsClicked" />
                        <Button Text="{loc:Loc TasbihSettings}" Clicked="OnTasbihClicked" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
