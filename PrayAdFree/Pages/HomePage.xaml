<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pray_Ad_Free.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
    Title="{loc:Loc Today}">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource SkyTop}, Dark={StaticResource DarkSkyTop}}" />
                <GradientStop Offset="0.6" Color="{AppThemeBinding Light={StaticResource SkyMid}, Dark={StaticResource DarkSkyMid}}" />
                <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" />
            </LinearGradientBrush>
        </Grid.Background>

        <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="24,20,24,28" Spacing="16">
                    <Label
                        FontAttributes="Bold"
                        FontSize="34"
                        HorizontalTextAlignment="Center"
                        Text="بسم الله الرحمن الرحيم" />
                    <Label
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        Text="{loc:Loc PrayTable}"
                        TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                    Dark={StaticResource TextMutedDark}}" />

                    <Border Padding="16" StrokeShape="RoundRectangle 20">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label
                                    Grid.Column="2"
                                    FontSize="30"
                                    HorizontalTextAlignment="Start"
                                    Text="⌖"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDark},
                                                                Dark={StaticResource Accent}}"
                                    VerticalTextAlignment="Start" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="24"
                                    HorizontalTextAlignment="End"
                                    Text="{Binding LocationTitle}" />
                            </Grid>
                            <Label
                                FontSize="13"
                                HorizontalTextAlignment="End"
                                Text="{Binding GregorianDate}"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                            Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Secondary},
                                                              Dark={StaticResource DarkSandMid}}"
                            Stroke="{AppThemeBinding Light={StaticResource Primary},
                                                     Dark={StaticResource SurfaceHighlightDark}}"
                            StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontSize="12"
                                    HorizontalTextAlignment="End"
                                    Text="{loc:Loc TimeLeft}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                Dark={StaticResource TextMutedDark}}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="30"
                                    HorizontalTextAlignment="End"
                                    Text="{Binding Countdown}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDark},
                                                                Dark={StaticResource Accent}}" />
                                <Label
                                    FontSize="12"
                                    HorizontalTextAlignment="End"
                                    Text="{Binding NextPrayerDayLabel}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDark},
                                                                Dark={StaticResource Accent}}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border
                            Grid.Column="1"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass},
                                                              Dark={StaticResource SurfaceGlassDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource SurfaceHighlight},
                                                     Dark={StaticResource SurfaceHighlightDark}}"
                            StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontSize="12"
                                    HorizontalTextAlignment="End"
                                    Text="{loc:Loc NextPrayer}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                Dark={StaticResource TextMutedDark}}" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="30"
                                    HorizontalTextAlignment="End"
                                    Text="{Binding NextPrayerName}" />
                                <Label
                                    FontSize="16"
                                    HorizontalTextAlignment="End"
                                    Text="{Binding NextPrayerClock}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryDark},
                                                                Dark={StaticResource Accent}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Padding="14" StrokeShape="RoundRectangle 20">
                        <VerticalStackLayout Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalTextAlignment="End"
                                Text="{loc:Loc TodayPrayTimesLabel}"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                            Dark={StaticResource TextMutedDark}}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TodayTimings}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            Padding="8,10"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="14">
                                            <Label
                                                FontSize="20"
                                                HorizontalTextAlignment="Start"
                                                Text="{Binding Time}"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                                            Dark={StaticResource White}}"
                                                VerticalTextAlignment="Center" />
                                            <Label
                                                Grid.Column="1"
                                                FontSize="22"
                                                HorizontalTextAlignment="End"
                                                LineBreakMode="NoWrap"
                                                Text="{Binding Name}"
                                                VerticalTextAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="16" StrokeShape="RoundRectangle 20">
                        <VerticalStackLayout Spacing="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                HorizontalTextAlignment="End"
                                Text="الإمساك والإفطار"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryDark},
                                                            Dark={StaticResource Accent}}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Border Padding="10" StrokeThickness="0">
                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsIftarNext}"
                                            TargetType="Border"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSandMid}}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsIftarNext}"
                                            TargetType="Border"
                                            Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontSize="13"
                                            HorizontalTextAlignment="Center"
                                            Text="{loc:Loc Iftar}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                        Dark={StaticResource TextMutedDark}}" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="28"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding IftarTime}">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsIftarNext}"
                                                    TargetType="Label"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource Accent}}" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding IsIftarNext}"
                                                    TargetType="Label"
                                                    Value="False">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsIftarNext}"
                                            Text="{Binding NextFastingCountdown}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                        Dark={StaticResource TextMutedDark}}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    Padding="10"
                                    StrokeThickness="0">
                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsImsakNext}"
                                            TargetType="Border"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource DarkSandMid}}" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsImsakNext}"
                                            TargetType="Border"
                                            Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontSize="13"
                                            HorizontalTextAlignment="Center"
                                            Text="{loc:Loc Imsak}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                        Dark={StaticResource TextMutedDark}}" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="28"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding ImsakTime}">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsImsakNext}"
                                                    TargetType="Label"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource Accent}}" />
                                                </DataTrigger>
                                                <DataTrigger
                                                    Binding="{Binding IsImsakNext}"
                                                    TargetType="Label"
                                                    Value="False">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding IsImsakNext}"
                                            Text="{Binding NextFastingCountdown}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                                        Dark={StaticResource TextMutedDark}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
