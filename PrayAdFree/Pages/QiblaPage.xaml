<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
             x:Class="Pray_Ad_Free.Pages.QiblaPage"
             Title="{loc:Loc Qibla}">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.3" Radius="0.8">
                <GradientStop Color="{StaticResource NightTop}" Offset="0"/>
                <GradientStop Color="{StaticResource NightBase}" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="20"
                                 Padding="24,32"
                                 HorizontalOptions="Center"
                                 WidthRequest="{OnPlatform WinUI=720, MacCatalyst=720, Default=-1}">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass}, Dark={StaticResource SurfaceGlassDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Loc QiblaDirection}" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                        <Label Text="{Binding LocationTitle}" FontSize="18" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                            <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="{StaticResource TextSubtle}" />
                            <Label Text="{Binding Bearing, StringFormat='{0:F0} deg'}"
                                   Grid.Column="1"
                                   FontSize="16"
                                   TextColor="{StaticResource Accent}"
                                   HorizontalTextAlignment="End" />
                            <Label Text="{loc:Loc Heading}"
                                   Grid.Row="1"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="{Binding Heading, StringFormat='{0:F0} deg'}"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSolid}, Dark={StaticResource SurfaceGlassDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        Padding="18">
                    <Grid HeightRequest="{OnPlatform WinUI=380, MacCatalyst=380, Android=300, iOS=300}">
                        <Ellipse Fill="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}" />
                        <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2" Opacity="0.6" />
                        <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="1" Opacity="0.3"
                                 Margin="24" />

                        <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*,Auto">
                            <Label Text="N" Grid.Row="0" Grid.Column="1" FontSize="12" TextColor="{StaticResource Accent}" HorizontalOptions="Center" />
                            <Label Text="W" Grid.Row="1" Grid.Column="0" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" VerticalOptions="Center" />
                            <Label Text="E" Grid.Row="1" Grid.Column="2" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" VerticalOptions="Center" />
                            <Label Text="S" Grid.Row="2" Grid.Column="1" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" HorizontalOptions="Center" />
                        </Grid>

                        <Polygon Points="0,90 26,0 52,90 26,70"
                                 Fill="{StaticResource Accent}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Rotation="{Binding NeedleRotation}" />
                        <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource Accent}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />

                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="{Binding Bearing, StringFormat='{0:F0} deg'}" FontSize="26" />
                        <Label Text="{loc:Loc Qibla}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSolid}, Dark={StaticResource SurfaceGlassDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Loc Location}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
                        <Grid>
                            <ContentView x:Name="MapHost"
                                         HeightRequest="{OnPlatform WinUI=280, MacCatalyst=280, Android=220, iOS=220}"
                                         IsVisible="{OnPlatform WinUI=false, Android=true, iOS=true, MacCatalyst=true}" />
                            <WebView x:Name="QiblaWeb"
                                     HeightRequest="{OnPlatform WinUI=280, MacCatalyst=280, Android=220, iOS=220}"
                                     IsVisible="{OnPlatform WinUI=true, Android=false, iOS=false, MacCatalyst=false}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
