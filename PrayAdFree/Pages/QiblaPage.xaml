<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Pray_Ad_Free.Pages.QiblaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Pray_Ad_Free.Controls"
    xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
    Title="{loc:Loc Qibla}">

    <ContentPage.Resources>
        <!--  Active chip style  -->
        <Style x:Key="ChipActive" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TealSoft}, Dark={StaticResource TealSoft}}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Teal}, Dark={StaticResource Teal}}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <!--  Inactive chip style  -->
        <Style x:Key="ChipInactive" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceHighlight}, Dark={StaticResource SurfaceHighlightDark}}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource SurfaceHighlightDark}}" />
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style x:Key="ChipLabel" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChipLabelActive" TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource Teal}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{AppThemeBinding Light={StaticResource SkyTop}, Dark={StaticResource DarkSkyTop}}" />
                <GradientStop Offset="0.5" Color="{AppThemeBinding Light={StaticResource SkyMid}, Dark={StaticResource DarkSkyMid}}" />
                <GradientStop Offset="1" Color="{AppThemeBinding Light={StaticResource SkyBase}, Dark={StaticResource DarkSkyBase}}" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout
                Padding="20,20,20,32"
                HorizontalOptions="Center"
                Spacing="14"
                WidthRequest="{OnPlatform WinUI=680,
                                          MacCatalyst=680,
                                          Default=-1}">

                <!--  Degree hero + direction  -->
                <Border
                    Padding="20,18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass},
                                                      Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                             Dark={StaticResource SurfaceHighlightDark}}"
                    StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            CharacterSpacing="1.2"
                            FontSize="11"
                            HorizontalTextAlignment="Center"
                            Text="{loc:Loc QiblaDirection}"
                            TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                        Dark={StaticResource Teal}}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="56"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Bearing, StringFormat='{0:F0}°'}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryDark},
                                                        Dark={StaticResource Accent}}" />
                        <Label
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            Text="{Binding DirectionLabel}"
                            TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                        Dark={StaticResource TextMutedDark}}" />
                        <Label
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            Text="{Binding StatusMessage}"
                            TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                        Dark={StaticResource TextMutedDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Display options  -->
                <Border
                    Padding="16,14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass},
                                                      Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                             Dark={StaticResource SurfaceHighlightDark}}"
                    StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="12">

                        <!--  Heading mode row  -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label
                                FontSize="13"
                                Text="{loc:Loc QiblaHeadingMode}"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                            Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Border x:Name="HeadingAutoChip" Style="{StaticResource ChipActive}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnHeadingAutoTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        x:Name="HeadingAutoLabel"
                                        Style="{StaticResource ChipLabelActive}"
                                        Text="{loc:Loc QiblaHeadingMode_Auto}" />
                                </Border>
                                <Border x:Name="HeadingManualChip" Style="{StaticResource ChipInactive}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnHeadingManualTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        x:Name="HeadingManualLabel"
                                        Style="{StaticResource ChipLabel}"
                                        Text="{loc:Loc QiblaHeadingMode_Manual}" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceHighlightDark}}" />

                        <!--  Display mode row  -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label
                                FontSize="13"
                                Text="{loc:Loc QiblaDisplayMode}"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                            Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Border x:Name="ModeCompassChip" Style="{StaticResource ChipActive}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnModeCompassTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        x:Name="ModeCompassLabel"
                                        Style="{StaticResource ChipLabelActive}"
                                        Text="{loc:Loc QiblaModeCompass}" />
                                </Border>
                                <Border x:Name="ModeMapChip" Style="{StaticResource ChipInactive}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnModeMapTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        x:Name="ModeMapLabel"
                                        Style="{StaticResource ChipLabel}"
                                        Text="{loc:Loc QiblaModeMap}" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceHighlightDark}}" />

                        <!--  Visual filter row  -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label
                                FontSize="13"
                                Text="{loc:Loc QiblaVisualFilter}"
                                TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                            Dark={StaticResource TextMutedDark}}"
                                VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Border x:Name="FilterNoneChip" Style="{StaticResource ChipActive}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFilterNoneTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        x:Name="FilterNoneLabel"
                                        Style="{StaticResource ChipLabelActive}"
                                        Text="{loc:Loc QiblaVisualFilter_None}" />
                                </Border>
                                <Border x:Name="FilterNightChip" Style="{StaticResource ChipInactive}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFilterNightTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        x:Name="FilterNightLabel"
                                        Style="{StaticResource ChipLabel}"
                                        Text="{loc:Loc QiblaVisualFilter_Night}" />
                                </Border>
                                <Border x:Name="FilterContrastChip" Style="{StaticResource ChipInactive}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFilterContrastTapped" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        x:Name="FilterContrastLabel"
                                        Style="{StaticResource ChipLabel}"
                                        Text="{loc:Loc QiblaVisualFilter_Contrast}" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!--  Compass  -->
                <Border
                    x:Name="CompassCard"
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass},
                                                      Dark={StaticResource SurfaceGlassDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                             Dark={StaticResource SurfaceHighlightDark}}"
                    StrokeShape="RoundRectangle 22">
                    <Border.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnManualPanUpdated" />
                    </Border.GestureRecognizers>
                    <controls:QiblaCompassView
                        x:Name="CompassDial"
                        Bearing="{Binding Bearing}"
                        Heading="{Binding Heading}"
                        HeightRequest="{OnPlatform WinUI=340,
                                                   MacCatalyst=340,
                                                   Android=300,
                                                   iOS=300}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="{OnPlatform WinUI=340,
                                                  MacCatalyst=340,
                                                  Android=300,
                                                  iOS=300}" />
                </Border>

                <!--  Map  -->
                <Border
                    x:Name="MapContainer"
                    Padding="14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceGlass},
                                                      Dark={StaticResource SurfaceGlassDark}}"
                    IsVisible="False"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200},
                                             Dark={StaticResource SurfaceHighlightDark}}"
                    StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            CharacterSpacing="0.8"
                            FontSize="11"
                            Text="{loc:Loc Location}"
                            TextColor="{AppThemeBinding Light={StaticResource TextMuted},
                                                        Dark={StaticResource TextMutedDark}}" />
                        <Grid>
                            <ContentView
                                x:Name="MapHost"
                                HeightRequest="{OnPlatform WinUI=280,
                                                           MacCatalyst=280,
                                                           Android=220,
                                                           iOS=220}"
                                IsVisible="{OnPlatform WinUI=false,
                                                       Android=false,
                                                       iOS=true,
                                                       MacCatalyst=true}" />
                            <WebView
                                x:Name="QiblaWeb"
                                HeightRequest="{OnPlatform WinUI=280,
                                                           MacCatalyst=280,
                                                           Android=220,
                                                           iOS=220}"
                                IsVisible="{OnPlatform WinUI=true,
                                                       Android=true,
                                                       iOS=false,
                                                       MacCatalyst=false}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
