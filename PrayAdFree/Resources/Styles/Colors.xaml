<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#0E6B61</Color>
    <Color x:Key="PrimaryDark">#084C45</Color>
    <Color x:Key="Secondary">#F2E9D8</Color>
    <Color x:Key="Accent">#E07B39</Color>

    <Color x:Key="SkyTop">#E8F1FF</Color>
    <Color x:Key="SkyMid">#DCE9F4</Color>
    <Color x:Key="SkyBase">#F6E2C4</Color>
    <Color x:Key="DarkSkyTop">#0E141C</Color>
    <Color x:Key="DarkSkyMid">#141C26</Color>
    <Color x:Key="DarkSkyBase">#1B242F</Color>

    <Color x:Key="SandTop">#F7F1E6</Color>
    <Color x:Key="SandMid">#EBDCC6</Color>
    <Color x:Key="SandBase">#D8C2A2</Color>
    <Color x:Key="DarkSandTop">#12161E</Color>
    <Color x:Key="DarkSandMid">#1A212B</Color>
    <Color x:Key="DarkSandBase">#202A35</Color>

    <Color x:Key="NightTop">#1C2630</Color>
    <Color x:Key="NightBase">#0C1218</Color>

    <Color x:Key="SurfaceGlass">#FFFDF7</Color>
    <Color x:Key="SurfaceSolid">#FFFFFF</Color>
    <Color x:Key="SurfaceHighlight">#FFEED6</Color>
    <Color x:Key="SurfaceGlassDark">#1B232D</Color>
    <Color x:Key="SurfaceHighlightDark">#24303B</Color>

    <Color x:Key="TextMuted">#6F6356</Color>
    <Color x:Key="TextSubtle">#8C7F70</Color>
    <Color x:Key="TextMutedDark">#B6B0A6</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">#1C1915</Color>
    <Color x:Key="OffBlack">#0E0D0B</Color>

    <Color x:Key="Gray100">#F5F2ED</Color>
    <Color x:Key="Gray200">#E7E0D8</Color>
    <Color x:Key="Gray300">#C9BFB3</Color>
    <Color x:Key="Gray400">#AA9F92</Color>
    <Color x:Key="Gray500">#7D7266</Color>
    <Color x:Key="Gray600">#554B42</Color>
    <Color x:Key="Gray900">#2B2520</Color>
    <Color x:Key="Gray950">#1A1613</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
</ResourceDictionary>
