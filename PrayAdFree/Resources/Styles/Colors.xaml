<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═══════════════════════════════════════════
         SACRED NIGHT — Design System Colors
         Light  = warm ivory / sand
         Dark   = deep midnight navy
    ═══════════════════════════════════════════ -->

    <!-- LIGHT MODE — Sky / Sand -->
    <Color x:Key="SkyTop">#F7F3EC</Color>
    <Color x:Key="SkyMid">#EEE8DC</Color>
    <Color x:Key="SkyBase">#E4DCCC</Color>

    <Color x:Key="SandTop">#FBF8F2</Color>
    <Color x:Key="SandMid">#F0E9DC</Color>
    <Color x:Key="SandBase">#E2D8C8</Color>

    <!-- DARK MODE — Deep Navy -->
    <Color x:Key="DarkSkyTop">#0D1117</Color>
    <Color x:Key="DarkSkyMid">#111822</Color>
    <Color x:Key="DarkSkyBase">#141E2C</Color>

    <Color x:Key="DarkSandTop">#1C2433</Color>
    <Color x:Key="DarkSandMid">#243040</Color>
    <Color x:Key="DarkSandBase">#2C3A4F</Color>

    <Color x:Key="NightTop">#0A0F18</Color>
    <Color x:Key="NightBase">#161E2C</Color>

    <!-- ACCENT — Gold (primary accent) -->
    <Color x:Key="Accent">#C9A84C</Color>
    <Color x:Key="AccentSoft">#EADFC9</Color>
    <Color x:Key="AccentSoftDark">#4C3C21</Color>
    <Color x:Key="AccentMid">#DDCB9E</Color>
    <Color x:Key="AccentMidDark">#7C6538</Color>

    <!-- INPUTS — derived from surface + primary -->
    <Color x:Key="InputFill">#F2ECDF</Color>
    <Color x:Key="InputFillDark">#263645</Color>
    <Color x:Key="InputFillFocused">#ECE3D0</Color>
    <Color x:Key="InputFillFocusedDark">#314355</Color>
    <Color x:Key="InputFillDisabled">#A89F90</Color>
    <Color x:Key="InputFillDisabledDark">#18222C</Color>
    <Color x:Key="InputStroke">#D6C19A</Color>
    <Color x:Key="InputStrokeDark">#7E6844</Color>
    <Color x:Key="InputTint">#C9A84C</Color>
    <Color x:Key="InputTintDark">#DABD6F</Color>
    <Color x:Key="InputForeground">#000000</Color>
    <Color x:Key="InputForegroundDark">#FFFFFF</Color>
    <Color x:Key="InputForegroundFocused">#000000</Color>
    <Color x:Key="InputForegroundFocusedDark">#FFFFFF</Color>
    <Color x:Key="InputForegroundDisabled">#FFFFFF</Color>
    <Color x:Key="InputForegroundDisabledDark">#FFFFFF</Color>
    <Color x:Key="InputFillActive">#F2ECDF</Color>
    <Color x:Key="InputFillFocusedActive">#ECE3D0</Color>
    <Color x:Key="InputFillDisabledActive">#A89F90</Color>
    <Color x:Key="InputStrokeActive">#D6C19A</Color>
    <Color x:Key="InputTintActive">#C9A84C</Color>
    <Color x:Key="InputForegroundActive">#000000</Color>
    <Color x:Key="InputForegroundFocusedActive">#000000</Color>
    <Color x:Key="InputForegroundDisabledActive">#FFFFFF</Color>

    <!-- ACTIONS — primary / subtle / disabled -->
    <Color x:Key="PrimaryForeground">#FFFFFF</Color>
    <Color x:Key="PrimaryDisabled">#6A5032</Color>
    <Color x:Key="PrimaryDisabledDark">#6A5032</Color>
    <Color x:Key="PrimaryDisabledForeground">#FFFFFF</Color>
    <Color x:Key="PrimaryDisabledForegroundDark">#FFFFFF</Color>
    <Color x:Key="PrimaryDisabledActive">#6A5032</Color>
    <Color x:Key="PrimaryDisabledForegroundActive">#FFFFFF</Color>
    <Color x:Key="SubtleActionFill">#F2ECDF</Color>
    <Color x:Key="SubtleActionFillDark">#263645</Color>
    <Color x:Key="SubtleActionForeground">#000000</Color>
    <Color x:Key="SubtleActionForegroundDark">#FFFFFF</Color>
    <Color x:Key="SubtleActionDisabled">#A89F90</Color>
    <Color x:Key="SubtleActionDisabledDark">#18222C</Color>
    <Color x:Key="SubtleActionDisabledForeground">#FFFFFF</Color>
    <Color x:Key="SubtleActionDisabledForegroundDark">#FFFFFF</Color>
    <Color x:Key="SubtleActionFillActive">#F2ECDF</Color>
    <Color x:Key="SubtleActionForegroundActive">#000000</Color>
    <Color x:Key="SubtleActionDisabledActive">#A89F90</Color>
    <Color x:Key="SubtleActionDisabledForegroundActive">#FFFFFF</Color>

    <!-- CHIPS -->
    <Color x:Key="ChipActiveFill">#EADFC9</Color>
    <Color x:Key="ChipActiveFillDark">#4C3C21</Color>
    <Color x:Key="ChipActiveStroke">#DDCB9E</Color>
    <Color x:Key="ChipActiveStrokeDark">#7C6538</Color>
    <Color x:Key="ChipActiveForeground">#000000</Color>
    <Color x:Key="ChipActiveForegroundDark">#FFFFFF</Color>
    <Color x:Key="ChipInactiveFill">#F2ECDF</Color>
    <Color x:Key="ChipInactiveFillDark">#263645</Color>
    <Color x:Key="ChipInactiveStroke">#D6C19A</Color>
    <Color x:Key="ChipInactiveStrokeDark">#7E6844</Color>
    <Color x:Key="ChipInactiveForeground">#000000</Color>
    <Color x:Key="ChipInactiveForegroundDark">#FFFFFF</Color>
    <Color x:Key="ChipActiveFillActive">#EADFC9</Color>
    <Color x:Key="ChipActiveStrokeActive">#DDCB9E</Color>
    <Color x:Key="ChipActiveForegroundActive">#000000</Color>
    <Color x:Key="ChipInactiveFillActive">#F2ECDF</Color>
    <Color x:Key="ChipInactiveStrokeActive">#D6C19A</Color>
    <Color x:Key="ChipInactiveForegroundActive">#000000</Color>

    <!-- SWITCH -->
    <Color x:Key="SwitchTrackOn">#DCC89B</Color>
    <Color x:Key="SwitchTrackOnDark">#5C4A2E</Color>
    <Color x:Key="SwitchTrackOff">#A89F90</Color>
    <Color x:Key="SwitchTrackOffDark">#18222C</Color>
    <Color x:Key="SwitchThumbOn">#000000</Color>
    <Color x:Key="SwitchThumbOnDark">#FFFFFF</Color>
    <Color x:Key="SwitchThumbOff">#FFFFFF</Color>
    <Color x:Key="SwitchThumbOffDark">#FFFFFF</Color>
    <Color x:Key="SwitchTrackOnActive">#DCC89B</Color>
    <Color x:Key="SwitchTrackOffActive">#A89F90</Color>
    <Color x:Key="SwitchThumbOnActive">#000000</Color>
    <Color x:Key="SwitchThumbOffActive">#FFFFFF</Color>

    <!-- ACCENT — Teal (secondary / active states) -->
    <Color x:Key="Teal">#3FBFA0</Color>
    <Color x:Key="TealSoft">#3FBFA01A</Color>

    <!-- PRIMARY (light mode brand) -->
    <Color x:Key="Primary">#7A6040</Color>
    <Color x:Key="PrimaryDark">#5A4020</Color>

    <!-- SECONDARY (light mode surface tint) -->
    <Color x:Key="Secondary">#EDE0CC</Color>

    <!-- SURFACE — Light Mode -->
    <Color x:Key="SurfaceGlass">#FFFFFFB0</Color>
    <Color x:Key="SurfaceHighlight">#F0E8D8</Color>
    <Color x:Key="SurfaceSolid">#FAF6EE</Color>

    <!-- SURFACE — Dark Mode -->
    <Color x:Key="SurfaceGlassDark">#1C2433</Color>
    <Color x:Key="SurfaceHighlightDark">#243040</Color>
    <Color x:Key="SurfaceSolidDark">#161C27</Color>

    <!-- TEXT -->
    <Color x:Key="TextMuted">#8A7A66</Color>
    <Color x:Key="TextMutedDark">#8B9AAE</Color>
    <Color x:Key="TextSubtle">#B0A090</Color>
    <Color x:Key="TextSubtleDark">#4A5568</Color>

    <!-- NEUTRALS -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#0F1115</Color>
    <Color x:Key="Gray100">#F2ECE3</Color>
    <Color x:Key="Gray200">#E8E2DA</Color>
    <Color x:Key="Gray300">#D0C8BC</Color>
    <Color x:Key="Gray400">#B6AC9C</Color>
    <Color x:Key="Gray500">#978B78</Color>
    <Color x:Key="Gray600">#7A7060</Color>
    <Color x:Key="Gray900">#1A1610</Color>
    <Color x:Key="Gray950">#0F0C08</Color>

    <!-- SEMANTIC — status colors -->
    <Color x:Key="Success">#3FBFA0</Color>
    <Color x:Key="Warning">#C9A84C</Color>
    <Color x:Key="Danger">#E05555</Color>

</ResourceDictionary>
