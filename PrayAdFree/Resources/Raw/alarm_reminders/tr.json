[
  { "id": "niyyah", "text": "Niyetini yenile ve ihlasi hatirla." },
  { "id": "khushu", "text": "Namaza sakinlik ve huzurla dur." },
  { "id": "takbir", "text": "Allahu Akbar derken kalbini topla." },
  { "id": "istighfar", "text": "Namazdan sonra Astaghfirullah de." },
  { "id": "dua_after", "text": "Selamdan sonra kisa bir dua et." }
