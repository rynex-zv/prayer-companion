[
  { "id": "niyyah", "text": "جدّد نيتك واطلب الإخلاص." },
  { "id": "khushu", "text": "قِف في الصلاة بهدوء وخشوع." },
  { "id": "takbir", "text": "قل الله أكبر بقلب حاضر." },
  { "id": "istighfar", "text": "لا تنسَ الاستغفار بعد الصلاة." },
  { "id": "dua_after", "text": "خذ لحظة قصيرة للدعاء بعد التسليم." }
]
