<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
             x:Class="Pray_Ad_Free.Controls.LocationSetupView">
    <ContentView.Resources>
        <Style TargetType="Entry">
            <Setter Property="BackgroundColor" Value="{DynamicResource InputFillActive}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextColor" Value="{DynamicResource InputForegroundActive}" />
            <Setter Property="PlaceholderColor" Value="{DynamicResource InputForegroundActive}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="MinimumWidthRequest" Value="44" />
        </Style>
        <Style TargetType="Picker">
            <Setter Property="BackgroundColor" Value="{DynamicResource InputFillActive}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextColor" Value="{DynamicResource InputForegroundActive}" />
            <Setter Property="TitleColor" Value="{DynamicResource InputForegroundActive}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="MinimumWidthRequest" Value="44" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
            <Label Text="{loc:Loc UseGps}" FontSize="14" VerticalOptions="Center" />
            <Switch Grid.Column="1" IsToggled="{Binding UseGps}" VerticalOptions="Center" HorizontalOptions="Center" />
            <Button Grid.Column="2" Text="{loc:Loc UpdateGps}" Command="{Binding RefreshGpsCommand}" VerticalOptions="Center" />
        </Grid>

        <Label Text="{loc:Loc Country}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
        <Picker Title="{loc:Loc Country}"
                ItemsSource="{Binding CountryOptions}"
                ItemDisplayBinding="{Binding Label}"
                SelectedItem="{Binding SelectedCountry}"
                IsEnabled="{Binding IsManualLocationEnabled}" />

        <Label Text="{loc:Loc City}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
        <Picker Title="{loc:Loc City}"
                ItemsSource="{Binding CityOptions}"
                ItemDisplayBinding="{Binding Label}"
                SelectedItem="{Binding SelectedCity}"
                IsEnabled="{Binding IsManualLocationEnabled}" />

        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
            <Label Text="{loc:Loc Latitude}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
            <Label Grid.Column="1" Text="{loc:Loc Longitude}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}" />
            <Entry Grid.Row="1" Placeholder="{loc:Loc Latitude}" Text="{Binding Latitude}" IsEnabled="{Binding IsManualLocationEnabled}" />
            <Entry Grid.Row="1" Grid.Column="1" Placeholder="{loc:Loc Longitude}" Text="{Binding Longitude}" IsEnabled="{Binding IsManualLocationEnabled}" />
        </Grid>
    </VerticalStackLayout>
</ContentView>

