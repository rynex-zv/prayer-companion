<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Pray_Ad_Free.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Pray_Ad_Free.Pages"
    xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
    Title="Pray Ad Free">

    <TabBar>
        <ShellContent Route="today" Title="{loc:Loc Today}" ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent Route="calendar" Title="{loc:Loc Calendar}" ContentTemplate="{DataTemplate pages:CalendarPage}" />
        <ShellContent Route="qibla" Title="{loc:Loc Qibla}" ContentTemplate="{DataTemplate pages:QiblaPage}" />
        <ShellContent Route="tasbih" Title="{loc:Loc Tasbih}" ContentTemplate="{DataTemplate pages:TasbihPage}" />
        <ShellContent Route="settings" Title="{loc:Loc Settings}" ContentTemplate="{DataTemplate pages:SettingsPage}" />
        <ShellContent Route="about" Title="{loc:Loc About}" ContentTemplate="{DataTemplate pages:AboutPage}" />
    </TabBar>
</Shell>
