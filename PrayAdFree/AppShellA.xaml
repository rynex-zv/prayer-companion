<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Pray_Ad_Free.AppShellA"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagesA="clr-namespace:Pray_Ad_Free.Pages.ThemeA"
    xmlns:loc="clr-namespace:Pray_Ad_Free.Services"
    Title="{loc:Loc AppTitle}">

    <TabBar>
        <ShellContent Route="today" Title="{loc:Loc Today}" Icon="tab_sun.svg" ContentTemplate="{DataTemplate pagesA:HomePageA}" />
        <ShellContent Route="calendar" Title="{loc:Loc Calendar}" Icon="tab_calendar.svg" ContentTemplate="{DataTemplate pagesA:CalendarPageA}" />
        <ShellContent Route="qibla" Title="{loc:Loc Qibla}" Icon="tab_compass.svg" ContentTemplate="{DataTemplate pagesA:QiblaPageA}" />
        <ShellContent Route="tasbih" Title="{loc:Loc Tasbih}" Icon="tab_circle_dot.svg" ContentTemplate="{DataTemplate pagesA:TasbihPageA}" />
        <ShellContent Route="settingsA" Title="{loc:Loc Settings}" Icon="tab_settings.svg" ContentTemplate="{DataTemplate pagesA:SettingsPageA}" />
    </TabBar>
</Shell>
