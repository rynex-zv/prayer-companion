<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="package.json" />
    <None Include="package-lock.json" />
    <None Include="vite.config.js" />
    <None Include="tsconfig.json" />
    <None Include="web.config" />
    <None Include="src\**\*" />
    <None Include="scripts\**\*" />
    <None Include="docs\**\*" Condition="Exists('docs')" />
  </ItemGroup>

  <Target Name="BuildPrayWebPhone" BeforeTargets="Build" Condition="'$(BuildPrayWeb)' == 'true'">
    <Exec Command="npm run build -- --phone" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
