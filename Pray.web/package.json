{
  "name": "pray-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "generate:contracts": "dotnet run --project ../tools/generate-web-contracts/GenerateWebContracts.csproj",
    "build": "node scripts/build.mjs",
    "build:phone": "node scripts/build.mjs --phone",
    "build:love": "node scripts/build.mjs --love",
    "build:dev:love": "node scripts/build.mjs --love --dev",
    "build:all": "node scripts/build-all.mjs",
    "build:all:love": "node scripts/build-all.mjs --love",
    "build:all:dev:love": "node scripts/build-all.mjs --love --dev",
    "build:all:dev": "node scripts/build-all.mjs --dev",
    "build:all:phone": "node scripts/build-all.mjs --phone",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node scripts/check-client-boundaries.mjs"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.3.4",
    "vite": "^7.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.17",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.3"
  }
}
